#!/bin/sh
set -e

case "$1" in
configure)
    mkdir -p /usr/local/bin
    for tool in ffmpeg ffprobe; do
        target="/usr/bin/${tool}-rockchip"
        link="/usr/local/bin/${tool}"
        if [ -e "${link}" ] && [ ! -L "${link}" ]; then
            echo "ffmpeg-rockchip: ${link} exists and is not a symlink, leaving it alone" >&2
        else
            ln -sf "${target}" "${link}"
        fi
    done
    ;;
esac

#DEBHELPER#
